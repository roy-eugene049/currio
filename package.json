    "supabase:deploy:generate-curio": "supabase functions deploy generate-curio",
    "supabase:deploy:functions": "supabase functions deploy curio-feed && supabase functions deploy generate-curio && supabase functions deploy send-welcome-email --no-verify-jwt",
    "test:curio-feed": "node ./scripts/test-curio-feed.mjs",
    "build:apk": "eas build --platform android --profile preview",
    "build:apk:local": "eas build --platform android --profile preview --local"
  },
