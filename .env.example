# EXPO_PUBLIC_ prefix is required — these are bundled into the client app.
# Never put the secret key here.

# Project URL: Supabase Dashboard → Project Settings → API → Project URL
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Publishable key: Dashboard → API Keys → Publishable key (starts with sb_publishable_)
# This replaces the legacy "anon" key — safe to use in the mobile app.
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_key_here

# Optional — better per-curio backdrop photos (free at https://www.pexels.com/api/)
# Without this, backdrops use Wikimedia Commons based on each curio's title.
EXPO_PUBLIC_PEXELS_API_KEY=

# Phase 6 — load curios from Supabase curio-feed (requires signed-in user + seeded DB)
EXPO_PUBLIC_REMOTE_CURIOS=false

# Phase 5 — AI-generated curios (server-side; enable OPENAI_API_KEY in Supabase secrets)
EXPO_PUBLIC_AI_CURIOS=false

# ── Supabase Edge Function secrets (Dashboard → Edge Functions → Secrets) ──
# OPENAI_API_KEY=sk-...          # required for generate-curio
# PEXELS_API_KEY=...               # optional — backdrop photos on AI curios
# AI_CURIOS_ENABLED=true           # set false to disable AI without removing the key

# Supabase CLI only (NOT bundled into the app). Create at:
# https://supabase.com/dashboard/account/tokens
# Used by: SUPABASE_ACCESS_TOKEN=sbp_... npm run supabase:setup
# SUPABASE_ACCESS_TOKEN=
